# 开发文件
.vscode/**
CLAUDE.md
AGENTS.md
.claude/**
.vscode-test/**
src/**
examples/**
docs/**
.arkts/**

# 构建配置
tsconfig.json
esbuild.js
.eslintrc*
.eslintignore

# Git
.gitignore
.gitattributes

# 测试
out/test/**

# esbuild 已打包所有模块，tsc 分散输出文件不需要
out/config/**
out/mcp/**
out/providers/**

# 开发依赖不需要打包进 VSIX（运行时不需要）
node_modules/@types/**
node_modules/typescript/**
node_modules/eslint/**
node_modules/@typescript-eslint/**
node_modules/@vscode/test-cli/**
node_modules/@vscode/test-electron/**
node_modules/esbuild/**
node_modules/sharp/**
node_modules/zod/**
node_modules/@modelcontextprotocol/**

# wasm32 回退链（@ohos-rs/oxk / project-detector 的 wasm-wasi 可选依赖），桌面端用原生二进制，不需要
node_modules/@napi-rs/**
node_modules/@emnapi/**
node_modules/@tybys/**

# vscode-languageclient 运行时只 require .js；类型声明、文档、CLI 入口均为死重
node_modules/**/*.d.ts
node_modules/**/README*
node_modules/**/LICENSE*
node_modules/**/License*
node_modules/**/thirdpartynotices.txt
node_modules/**/CHANGELOG*
node_modules/**/bin/**
node_modules/**/*.cmd

# Source maps
**/*.map

# 备份和临时文件
**/*.backup
*.vsix

# 博客/文档
blog-*.md

# @arkts/language-server 已改为按需安装（扩展数据目录），不再随 VSIX 分发
node_modules/@arkts/**
