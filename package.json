{
  "name": "arkts-language-support",
  "displayName": "ArkTS Language Support - AI-Powered HarmonyOS Development",
  "description": "AI-powered ArkTS language support with MCP integration. Let Claude, Copilot, Cursor, or OpenCode assist your HarmonyOS development - manage devices, analyze projects, and debug apps with natural language.",
  "version": "2.1.0",
  "publisher": "cheliangzhao",
  "author": {
    "name": "车亮召"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FadingLight9291117/vscode-arkts.git"
  },
  "bugs": {
    "url": "https://github.com/FadingLight9291117/vscode-arkts/issues"
  },
  "homepage": "https://github.com/FadingLight9291117/vscode-arkts#readme",
  "keywords": [
    "arkts",
    "harmonyos",
    "hongmeng",
    "ets",
    "huawei",
    "language",
    "syntax",
    "highlighting",
    "mcp",
    "ai",
    "claude",
    "copilot",
    "cursor",
    "model-context-protocol",
    "ai-assistant",
    "device-management",
    "openharmony"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "arkts",
        "aliases": [
          "ArkTS",
          "arkts",
          "ets"
        ],
        "extensions": [
          ".ets"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/arkts-light.png",
          "dark": "./icons/arkts-dark.png"
        }
      },
      {
        "id": "json5",
        "aliases": [
          "JSON5",
          "json5"
        ],
        "extensions": [
          ".json5"
        ],
        "filenames": [
          "oh-package.json5",
          "build-profile.json5",
          "module.json5",
          "hvigorfile.json5"
        ],
        "configuration": "./language-configuration-json5.json"
      }
    ],
    "grammars": [
      {
        "language": "arkts",
        "scopeName": "source.arkts",
        "path": "./syntaxes/arkts.tmLanguage.json"
      },
      {
        "language": "json5",
        "scopeName": "source.json5",
        "path": "./syntaxes/json5.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "arkts",
        "path": "./snippets/arkts/basic.json"
      },
      {
        "language": "arkts",
        "path": "./snippets/arkts/ui.json"
      },
      {
        "language": "arkts",
        "path": "./snippets/arkts/v2.json"
      },
      {
        "language": "arkts",
        "path": "./snippets/arkts/api.json"
      }
    ],
    "commands": [
      {
        "command": "arkts.selectDevice",
        "title": "ArkTS: Select HarmonyOS Device"
      },
      {
        "command": "arkts.showProjectInfo",
        "title": "ArkTS: Show Project Info"
      },
      {
        "command": "arkts.restartServer",
        "title": "ArkTS: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "ArkTS",
      "properties": {
        "ets.sdkPath": {
          "type": "string",
          "default": "",
          "description": "OpenHarmony SDK 路径（对应 DevEco Studio 安装目录下的 sdk/default/openharmony）。更改后语言服务器将自动重启。"
        },
        "ets.hmsPath": {
          "type": "string",
          "default": "",
          "description": "HMS SDK 路径（对应 DevEco Studio 安装目录下的 sdk/default/harmony）。留空则不加载 HMS 类型。"
        },
        "ets.linterVersion": {
          "type": "string",
          "default": "1.1",
          "enum": ["1.1", "off"],
          "description": "ArkTS Linter 版本。设为 off 可禁用 ArkTS 规范检查。"
        },
        "ets.resourceReferenceDiagnostic": {
          "type": "string",
          "default": "error",
          "enum": ["error", "warning", "information", "off"],
          "description": "$r() 资源引用找不到时的诊断级别。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle -- --production",
    "compile": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "@arkts/language-server": "^1.3.10",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.27.4",
    "eslint": "^8.56.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3",
    "zod": "^3.24.1"
  }
}
